# KAI backend environment — copy to .env and fill in. NEVER commit .env.
# ── App ──────────────────────────────────────────────────────
APP_ENV=dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Database (host Postgres; psycopg v3 driver) ──────────────
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/kai
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=kai

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── CORS (comma-separated) ───────────────────────────────────
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Bootstrap admin (seeded on first startup if DB has no users)
ADMIN_EMAIL=admin@kai.local
ADMIN_PASSWORD=change-me-strong

# ── Local KAI chat model (Ollama) ────────────────────────────
# The customised security model. KAI never silently falls back to a cloud
# model when this is unreachable — it reports what is missing instead.
KAI_OLLAMA_MODEL=kai-security
OLLAMA_BASE_URL=http://127.0.0.1:11434
KAI_OLLAMA_NUM_CTX=8192
KAI_OLLAMA_TEMPERATURE=0.2
# CPU inference can be slow; non-stream calls use this ceiling (seconds).
KAI_OLLAMA_TIMEOUT_S=600

# ── Security tool execution ──────────────────────────────────
TOOL_EXEC_TIMEOUT_S=60
TOOL_OUTPUT_MAX_BYTES=200000
TOOL_RATE_LIMIT_PER_MIN=30
TOOL_MAX_AGENT_STEPS=6
# Privileged apt installs run ONE fixed argv via this helper after operator
# approval. "sudo" needs a scoped NOPASSWD sudoers rule (see README);
# "pkexec" prompts on the desktop. Empty disables real installs.
TOOL_INSTALL_HELPER=sudo
TOOL_INSTALL_ENABLED=true
